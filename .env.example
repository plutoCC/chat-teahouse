# Reference only: the app does NOT automatically load .env files.
# Set these variables in the terminal that launches the app.
PORT=4317
CHAT_TEA_DATA_DIR=./data

# Optional: installed Chrome or Edge for the experimental browser connector.
# CHAT_TEA_BROWSER_CHANNEL=chrome

# Optional: absolute path to the official Codex executable.
# CHAT_TEA_CODEX_PATH=/absolute/path/to/codex

# Optional, Windows startup scripts only: disable importing a local system proxy.
# CHAT_TEA_USE_SYSTEM_PROXY=0

# Configure model API keys in the app's Model Connections page, not this file.

# Optional invited website mode: npm run host (never tunnel the normal 4317 port).
# CHAT_TEA_PUBLIC_ORIGIN=https://tea.example.com
# CHAT_TEA_HOST_DATA_DIR=./data-hosted
# CHAT_TEA_ADMIN_PORT=4318
# CHAT_TEA_HOST_PORT=4319
# CHAT_TEA_HOST_DAILY_CNY=20
# CHAT_TEA_HOST_USER_DAILY_CNY=5
# CHAT_TEA_HOST_MONTHLY_CNY=300
# CHAT_TEA_HOST_USD_CNY=7
# CHAT_TEA_HOST_DAILY_CALLS=200
# CHAT_TEA_HOST_USER_DAILY_CALLS=50
# CHAT_TEA_HOST_CONCURRENCY=4
# CHAT_TEA_HOST_USER_CONCURRENCY=2
# CHAT_TEA_HOST_MAX_OUTPUT_TOKENS=16384
